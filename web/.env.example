# --- Demo mode toggle ---
# true  : fixtures/search-response.json 으로 응답 (CFN 미배포 상태에서도 UI 시연 가능)
# false : NEXT_PUBLIC_API_BASE 로 실 API 호출
NEXT_PUBLIC_USE_MOCK=true

# --- Real API endpoint ---
# CFN Outputs 의 SearchApiEndpoint 값을 그대로 넣는다.
# 예: https://abc123.execute-api.ap-northeast-2.amazonaws.com/prod
NEXT_PUBLIC_API_BASE=
